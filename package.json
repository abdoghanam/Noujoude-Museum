{
  "name": "noujoude-digital-heritage-museum",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Noujoude Digital Heritage Museum — bilingual (EN/AR) digital heritage museum. NOT an e-commerce site.",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "prepare:check": "node scripts/preflight.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "payload": "payload",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "migrate:create": "payload migrate:create",
    "migrate": "payload migrate",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:status": "docker compose ps postgres",
    "db:harden": "docker compose exec -T postgres sh /opt/ndm-db/harden-append-only.sh",
    "db:verify-privileges": "docker compose exec -T postgres sh /opt/ndm-db/verify-privileges.sh",
    "db:privilege-evidence": "sh scripts/db/run-privilege-tests.sh",
    "audit:assets": "node scripts/audit-assets.mjs",
    "audit:docx-alignment": "node scripts/check-docx-alignment.mjs",
    "audit:citations": "node scripts/verify-citations.mjs",
    "audit:tables": "node scripts/verify-tables.mjs",
    "audit:compose": "node scripts/verify-compose-config.mjs",
    "audit:workflow": "node scripts/verify-workflow-structure.mjs",
    "test:gates": "node scripts/tests/verify-tables.test.mjs && node scripts/tests/preflight-asset-reconciliation.test.mjs && node scripts/tests/verify-citations.test.mjs && node scripts/tests/verify-compose-config.test.mjs && node scripts/tests/verify-workflow-structure.test.mjs && node scripts/tests/preflight-pnpm-trap.test.mjs && node scripts/tests/copy-master-spec-output.test.mjs",
    "test:gate:tables": "node scripts/tests/verify-tables.test.mjs",
    "test:gate:assets": "node scripts/tests/preflight-asset-reconciliation.test.mjs",
    "test:gate:citations": "node scripts/tests/verify-citations.test.mjs",
    "test:gate:compose": "node scripts/tests/verify-compose-config.test.mjs",
    "test:gate:workflow": "node scripts/tests/verify-workflow-structure.test.mjs",
    "test:gate:pnpm-trap": "node scripts/tests/preflight-pnpm-trap.test.mjs",
    "test:gate:spec-copy": "node scripts/tests/copy-master-spec-output.test.mjs",
    "docs:spec-copy": "node scripts/copy-master-spec.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/plugin-cloud-storage": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "graphql": "^16.8.1",
    "next": "16.4.3",
    "payload": "3.92.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "axe-core": "^4.10.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3",
    "typescript": "^5",
    "vitest": "^3"
  }
}
