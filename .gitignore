# Dependencies & build output
node_modules/
.next/
out/
build/
coverage/
*.tsbuildinfo
next-env.d.ts

# Environment and secrets — never committed (Standard §5, §15)
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Local databases and media produced by tooling
pgdata/
.tmp/
*.log

# Derivative renders written by scripts/build-media-derivatives.mjs. The bytes are reproducible from an
# original plus an authorised profile and ledger, so they are output, not source. That is still true now that
# the Owner's 4 November declaration cleared the library and the builder has run: `media-derivatives/` holds
# 45 recorded renders plus its manifest, and the renders remain output. What the gate suite
# (scripts/tests/build-media-derivatives.test.mjs) measures on every run is not the directory's absence but
# its immutability under a refused build — a refusal must leave the store byte-identical here and create
# nothing at all in a fresh workspace. `lineage.json` is the one exception below: it is the provenance record
# that makes a derivative traceable to its original (O-09), and a record is not a build artefact, so it is the
# one file in this directory that a clone is expected to carry. The directory is deliberately outside
# `Noujoude.photo/` (originals are never overwritten) and outside `public/` (nothing may be served without
# passing the gate, §20.4).
media-derivatives/*
!media-derivatives/lineage.json
# Committed test fixtures (derivatives) for CI reproducibility (Phase 8).
# These are the delivered store's files; without them the serving integration test
# cannot run on a clean checkout. They are reproducible from the lineage manifest.
!media-derivatives/*.webp

# Payload / Drizzle
# Migrations ARE source: they are committed (Standard §3.4). Generated types are
# derived and regenerated by `pnpm generate:types`.
src/generated/payload-types.ts

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Intermediate renders from the identity work. The scripts that made them are tracked
# on purpose — "layered, not traced" is a claim about process, and the process is the
# evidence — but the 11 MB of probe images they emitted are reproducible by re-running
# brand/_tools and are not an asset. Nothing here is deleted; it stays on disk.
brand/_trace/*.png
brand/_trace/*.jpg
brand/_tools/_t/*.jpg

# NOTE — deliberately NOT ignored, and deliberately protected:
#   reference/        read-only product, traceability, technology and asset inputs
#   Noujoude.photo/   original asset library; originals are never overwritten
#   docs/REFERENCE_INTEGRITY.json   checksum baseline that proves the above
# No ignore rule may ever hide a change to those paths.

# Playwright reporter and run-state output, written by a probe run of `pnpm test:e2e` on 2 Nov 2026.
# Regenerable on every run, so they must never reach the index or a digest manifest.
playwright-report/
test-results/

# Gate-run scratch written by this project's own tooling on 31 October 2026 (risk SR-34). They are
# transcripts of `node scripts/...` runs, superseded by every later measured run, and they were the
# residue `.gitignore` line 20's `.tmp/` rule never covered. Moved out of the working tree, byte-for-byte,
# to the 3 November evidence bundle `residue-tmp-txt-2026-11-03/` with their digests recorded there —
# preserved, not deleted. The rule stays so a future scratch redirect cannot silently re-litter the root.
tmp_*.txt

.vercel
