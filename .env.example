# Noujoude — environment template. Copy to .env and fill with real values.
# .env is git-ignored. NEVER commit a populated copy.
#
# Hard boundary (Technology & Security Standard §5, §15; Master Spec G.7):
#   Nothing in this file may be reachable from the Control Center UI, from a
#   browser bundle, from logs, or from telemetry.
#   Only NEXT_PUBLIC_* variables are ever sent to the client. None of the
#   values below may be renamed into a NEXT_PUBLIC_* variable.

# ─── Runtime identity ───────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Payload ────────────────────────────────────────────────────────────────
# 32+ character random secret used for Payload signing. Rotation invalidates sessions.
PAYLOAD_SECRET=change-me-to-a-long-random-value
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Database: four separate roles (Standard §3.2, ADR-005) ─────────────────
POSTGRES_DB=noujoude
POSTGRES_SUPERUSER=noujoude_admin
POSTGRES_SUPERUSER_PASSWORD=
# Used only by `pnpm migrate:create` / `pnpm migrate`. Must NOT be used by the app.
NDM_MIGRATION_PASSWORD=
# Used by the running application. No DDL privileges, not a superuser.
NDM_RUNTIME_PASSWORD=
# Read-only reporting/analytics.
NDM_REPORTING_PASSWORD=
# Isolated backup/restore identity (Standard §11). Never shared with the app.
NDM_BACKUP_PASSWORD=

# Connection strings carry the matching role, not a shared superuser string.
# Payload reads DATABASE_URI; it must be the RUNTIME role, never the migration
# role and never the bootstrap superuser.
DATABASE_URI=postgresql://ndm_runtime@127.0.0.1:5432/noujoude
DATABASE_URI_MIGRATION=postgresql://ndm_migration@127.0.0.1:5432/noujoude

# ─── Object storage: PRIVATE by default (Standard §6) ───────────────────────
# Originals are never public. Public serving uses short-lived signed URLs on
# re-encoded derivatives only.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_PRIVATE=noujoude-originals
S3_BUCKET_PUBLIC=noujoude-derivatives
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SIGNATURE_VERSION=v4

# ─── AI Curator provider (Master Spec §14, Standard §7) ─────────────────────
# Provider must sit behind a server-side adapter so credentials stay masked and
# replaceable. The AI must never be able to approve, verify or publish content.
AI_PROVIDER=
AI_PROVIDER_API_KEY=
AI_MODEL=
# Policy version is recorded per response for audit; do not hard-code in source.
AI_POLICY_VERSION=v1
# Explicit kill switch consumed by the retrieval layer, not by UI hiding.
AI_CURATOR_ENABLED=true

# ─── Email / inquiry routing (Master Spec §6.12) ────────────────────────────
# Inquiry payloads contain PII: private storage, excluded from search index and
# from AI knowledge by default.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
INQUIRY_NOTIFY_ADDRESS=

# ─── Observability (Standard §10) ───────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=noujoude-web
# Telemetry must carry no personal/inquiry content, no credentials, no tokens.

# ─── Rate limiting & CSRF ───────────────────────────────────────────────────
RATE_LIMIT_REDIS_URL=
CSRF_ORIGIN_ALLOWLIST=http://localhost:3000

# ─── Backups (Standard §11) ─────────────────────────────────────────────────
BACKUP_TARGET_URI=
BACKUP_RETENTION_DAILY=35
BACKUP_RETENTION_WEEKLY=12
BACKUP_RETENTION_MONTHLY=12
