# Noujoude — environment template. Copy to .env and fill with real values.
# .env is git-ignored. NEVER commit a populated copy.
#
# Hard boundary (Technology & Security Standard §5, §15; Master Spec G.7):
#   Nothing in this file may be reachable from the Control Center UI, from a
#   browser bundle, from logs, or from telemetry.
#   Only NEXT_PUBLIC_* variables are ever sent to the client. None of the
#   values below may be renamed into a NEXT_PUBLIC_* variable.

# ─── Runtime identity ───────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Payload ────────────────────────────────────────────────────────────────
# 32+ character random secret used for Payload signing. Rotation invalidates sessions.
PAYLOAD_SECRET=change-me-to-a-long-random-value
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Database: four separate roles (Standard §3.2, ADR-005) ─────────────────
POSTGRES_DB=noujoude
POSTGRES_SUPERUSER=noujoude_admin
POSTGRES_SUPERUSER_PASSWORD=
# Used only by `pnpm migrate:create` / `pnpm migrate`. Must NOT be used by the app.
NDM_MIGRATION_PASSWORD=
# Used by the running application. No DDL privileges, not a superuser.
NDM_RUNTIME_PASSWORD=
# Read-only reporting/analytics.
NDM_REPORTING_PASSWORD=
# Isolated backup/restore identity (Standard §11). Never shared with the app.
NDM_BACKUP_PASSWORD=

# Connection strings carry the matching role, not a shared superuser string.
# Payload reads DATABASE_URI; it must be the RUNTIME role, never the migration
# role and never the bootstrap superuser.
DATABASE_URI=postgresql://ndm_runtime@127.0.0.1:5432/noujoude
DATABASE_URI_MIGRATION=postgresql://ndm_migration@127.0.0.1:5432/noujoude

# ─── Object storage: PRIVATE by default (Standard §6) ───────────────────────
# Originals are never public. Public serving uses short-lived signed URLs on
# re-encoded derivatives only.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_PRIVATE=noujoude-originals
S3_BUCKET_PUBLIC=noujoude-derivatives
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SIGNATURE_VERSION=v4

# ─── AI Curator provider (Master Spec §14, Standard §7) ─────────────────────
# Provider must sit behind a server-side adapter so credentials stay masked and
# replaceable. The AI must never be able to approve, verify or publish content.
AI_PROVIDER=
AI_PROVIDER_API_KEY=
AI_MODEL=
# Policy version is recorded per response for audit; do not hard-code in source.
AI_POLICY_VERSION=v1
# Explicit kill switch consumed by the retrieval layer, not by UI hiding.
AI_CURATOR_ENABLED=true

# ─── Email / inquiry routing (Master Spec §6.12) ────────────────────────────
# Inquiry payloads contain PII: private storage, excluded from search index and
# from AI knowledge by default.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
INQUIRY_NOTIFY_ADDRESS=

# ─── Observability (Standard §10) ───────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=noujoude-web
# Telemetry must carry no personal/inquiry content, no credentials, no tokens.

# ─── Rate limiting & CSRF ───────────────────────────────────────────────────
# Read by src/lib/server/media/request-limits.ts (register SR-04, decided by ADR-034), which is wired into
# src/app/api/media/[assetId]/route.ts — the only API route this build has. Limiting is IN-PROCESS: buckets
# live in this process's memory, so with N workers a client gets N independent allowances and a restart
# forgets them.
# No distributed-store variable is declared in this file. RATE_LIMIT_REDIS_URL was removed on 2 November 2026
# under docs/IMPLEMENTATION_PLAN.md item 2.9(c): a template that names a service this build does not have is a
# declaration of a control nobody implemented. The module still refuses the variable when an operator sets it
# anyway, and refuses it closed — measured 2 Nov 2026 (evidence/live-sr04-rate-limit.txt section C9): every
# request to the endpoint answered 500 with a zero-byte body, the reason printed only to the server log, while
# page routes kept answering 200. Restoring the declaration belongs together with the Redis client and the
# compose service, not ahead of them.
# Empty means "use the measured default", never "zero". A zero capacity or a zero refill would deny every
# visitor for the rest of the process's life, so an out-of-range value throws instead of being coerced:
# capacity at least 1, refill any positive number, the two bounds a whole number.
# Burst allowance per client. Default 40. src/lib/media/usage-map.ts declares its widest route
# (`the-museum`, 11 entries + 1 `global`) as 12 derivative bindings, but what a served page asks for today is
# zero: `/ar/the-museum` measured 0 occurrences of `/api/media` and 0 `<img>` elements, because no derivative
# manifest exists and every slot renders without a source. So 40 is a margin over the future render, not
# headroom over the current one. The measured effect of the number itself: 200 concurrent requests from one
# address granted 48 and paced 152 in about one second (2 November evidence bundle, `live-sr04-rate-limit.txt`
# section C8).
RATE_LIMIT_BUCKET_CAPACITY=
# Tokens restored per second, and the sustained ceiling. Default 10 — above any real reading rate, low
# enough that an id-enumeration sweep is paced to 600 refusals a minute per client. Any positive number is
# valid, so a slower posture is declarable: 0.2 is one request every five seconds. Zero and negatives are
# refused rather than served as a permanent ban.
RATE_LIMIT_REFILL_PER_SECOND=
# Memory bound on tracked clients; past it the least-recently-seen settled bucket is evicted. Default 10000.
RATE_LIMIT_MAX_TRACKED_CLIENTS=
# Trusted proxies in front of this process. 0 (default) takes the leftmost x-forwarded-for entry, which is
# best-effort because a directly exposed caller can type that header itself. Set to the real hop count behind
# a proxy: the client address is then read that many positions from the right, which client-injected entries
# at the left cannot shift.
RATE_LIMIT_TRUSTED_PROXY_HOPS=
CSRF_ORIGIN_ALLOWLIST=http://localhost:3000

# ─── Backups (Standard §11) ─────────────────────────────────────────────────
BACKUP_TARGET_URI=
BACKUP_RETENTION_DAILY=35
BACKUP_RETENTION_WEEKLY=12
BACKUP_RETENTION_MONTHLY=12
